# Environment Variables for runningly-chat-web
# Copy this file to .env for local development (vite.config.ts uses VITE_ prefix for local server)
# On Vercel, set the NON-prefixed variables in Project → Settings → Environment Variables

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs must include:
#   - https://runningly-chat.t-chrome.com/api/auth/callback   (production)
#   - https://<your-preview>.vercel.app/api/auth/callback      (Vercel preview)
#   - http://localhost:5000/api/auth/callback                  (local dev via vite.config.ts)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Legacy VITE_-prefix versions are used by vite.config.ts local dev server only
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Session Secret ───────────────────────────────────────────────────────────
# Must be at least 32 characters (used for AES-256 encryption of session cookies)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-32-plus-character-session-secret-here

# Legacy VITE_-prefix for local dev
VITE_SESSION_SECRET=your-32-plus-character-session-secret-here

# ─── Vercel Postgres ───────────────────────────────────────────────────────────
# Set automatically by Vercel when you connect a Postgres database to this project
# (Storage → Create Database → Postgres → Connect to Project)
# Do NOT set these manually — Vercel injects them automatically.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Vercel Blob ──────────────────────────────────────────────────────────────
# Set automatically by Vercel when you create a Blob store and connect it.
# (Storage → Create Store → Blob → Connect to Project)
BLOB_READ_WRITE_TOKEN=

# ─── Google Cloud Logging (LOCAL DEVELOPMENT ONLY) ────────────────────────────
# Used only by vite.config.ts local dev server for Cloud Logging.
# Download the service account JSON file from Google Cloud Console.
# Place the file at: /runningly-chat-web/logging-service-account.json
# This file is .gitignored and should NEVER be committed.
# The Vercel production build does NOT use Google Cloud Logging.
# (To get: Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON)
